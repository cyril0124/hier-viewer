{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // elkjs indexes optional children in its declaration. Keep application code
    // strict while skipping upstream declaration-body checks.
    "skipLibCheck": true
  },
  "include": [
    "rust-hier-viewer/src/html/frontend/**/*.ts",
    "tests/**/*.test.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
